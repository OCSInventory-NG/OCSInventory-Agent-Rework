<?define ServicePublishDir = $(PayloadDir)\OCSInventory-Service\Any CPU\Release\net9.0\win-x64\publish ?>
<?define ServiceName = OCSInventory Agent ?>
<!-- Inno Setup AppId, see OCSInventory-Agent-Setup.iss -->
<?define InnoUninstallKey = SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{652EB54C-0A14-46AF-9F06-3BA7C294AFC9}_is1 ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode identifies the product across versions: never change it -->
  <Package Name="OCS Inventory Agent"
           Manufacturer="OCS Inventory"
           Version="$(AgentVersion)"
           UpgradeCode="{DB28C157-2FF1-4556-9EA8-857C0B1B8A72}"
           Scope="perMachine">

    <!-- Same version allowed so that 3.1.0 (final) replaces 3.1.0 (from 3.1.0-rc1) -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="OCSInventory.ico" SourceFile="$(AssetsDir)\OCSInventory.ico" />
    <Property Id="ARPPRODUCTICON" Value="OCSInventory.ico" />

    <!-- Public properties, see README.md -->
    <Property Id="OCS_URL" Secure="yes" />
    <Property Id="OCS_USERNAME" Secure="yes" />
    <Property Id="OCS_PASSWORD" Secure="yes" Hidden="yes" />
    <Property Id="OCS_CERTIFICATE" Secure="yes" />
    <Property Id="OCS_MODE" Secure="yes" />
    <Property Id="OCS_LOG_LEVEL" Secure="yes" />
    <Property Id="OCS_BYPASS_CERT" Secure="yes" />
    <Property Id="OCS_ADMIN_DATA" Secure="yes" />
    <Property Id="OCS_TAG" Secure="yes" />
    <!-- Holds the password while passed to the deferred custom action -->
    <Property Id="WriteConfig" Hidden="yes" />

    <Property Id="OCS_CONFIG_FILE">
      <DirectorySearch Id="OcsDataDirSearch" Path="[CommonAppDataFolder]OCSInventory-Agent" Depth="0">
        <FileSearch Name="config.json" />
      </DirectorySearch>
    </Property>

    <!-- Passed to the UninstallInno custom action -->
    <Property Id="INNO_UNINSTALL_KEY" Value="$(InnoUninstallKey)" />
    <Property Id="AGENT_SERVICE_NAME" Value="$(ServiceName)" />

    <Property Id="INNO_UNINSTALL_STRING">
      <RegistrySearch Root="HKLM" Key="$(InnoUninstallKey)" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64" Message="[ProductName] requires a 64-bit version of Windows." />
    <Launch Condition="Installed OR OCS_URL OR OCS_CONFIG_FILE"
            Message="OCS_URL is required when no configuration file exists." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OCS Inventory Agent" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

    <Binary Id="CustomActionsBinary"
            SourceFile="$(OCSInventoryCustomActions.TargetDir)$(OCSInventoryCustomActions.TargetName).CA.dll" />

    <!-- Silent removal of an installation made with the Inno Setup .exe: stops the
         service, runs the uninstaller and waits for the service to be deleted -->
    <CustomAction Id="PrepareUninstallInno"
                  BinaryRef="CustomActionsBinary"
                  DllEntry="PrepareUninstallInno"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="UninstallInno"
                  BinaryRef="CustomActionsBinary"
                  DllEntry="UninstallInno"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Writes or merges config.json from the OCS_* properties -->
    <CustomAction Id="PrepareConfig"
                  BinaryRef="CustomActionsBinary"
                  DllEntry="PrepareConfig"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="WriteConfig"
                  BinaryRef="CustomActionsBinary"
                  DllEntry="WriteConfig"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="PrepareUninstallInno" Before="UninstallInno"
              Condition="INNO_UNINSTALL_STRING AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UninstallInno" After="InstallInitialize"
              Condition="INNO_UNINSTALL_STRING AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PrepareConfig" Before="WriteConfig"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="WriteConfig" Before="StartServices"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Component>
        <File Id="AgentExe" Source="$(PayloadDir)\OCSInventory-Agent\ocsinventory-agent.exe" />
      </Component>

      <!-- Same Start menu entry as the Inno Setup installer ([Icons]). A non-advertised
           shortcut needs its own component with an HKCU KeyPath (ICE43, ICE57). -->
      <Component Id="AgentStartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="AgentStartMenuShortcut"
                  Name="OCS Inventory Agent"
                  Target="[#AgentExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="OCSInventory.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\OCS Inventory\OCS Inventory Agent"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component>
        <File Source="$(ServicePublishDir)\OCSInventory-Service.exe" KeyPath="yes" />
        <ServiceInstall Name="$(ServiceName)"
                        DisplayName="$(ServiceName)"
                        Description="Service starting periodically OCSInventory Agent for Windows."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem" />
        <ServiceControl Id="OcsServiceControl"
                        Name="$(ServiceName)"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- Other files of the service publish folder (appsettings.json...) -->
      <Files Include="$(ServicePublishDir)\**">
        <Exclude Files="$(ServicePublishDir)\OCSInventory-Service.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
